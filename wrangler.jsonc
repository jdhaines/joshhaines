{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Update to Cloudflare's exact Worker name shown in the dashboard for this
  // project before the first deploy -- if this doesn't match, `wrangler
  // deploy` will create a brand new Worker instead of updating the one
  // already connected via Git.
  "name": "joshhainesnext",
  "compatibility_date": "2026-07-27",
  // Recipient for moderation-notification emails, and the site origin used
  // to build absolute one-click moderation links in that email (see
  // workers/comments-api.ts). Neither is a secret -- fine to keep in source
  // control. The signing key for those links (COMMENT_MODERATION_SECRET) is
  // a real secret -- see DEVELOPER.md's "Comments" section.
  "vars": {
    "COMMENT_NOTIFY_EMAIL": "Josh@JoshHaines.com",
    "COMMENT_SITE_ORIGIN": "https://joshhaines.com",
  },
  // Small Worker script that only handles the /api/comments endpoints
  // (see workers/comments-api.ts) -- `run_worker_first` scopes it to just
  // those routes, so every other request is still served directly from
  // the static asset bundle without invoking this script at all.
  "main": "workers/comments-api.ts",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // Update "database_id" with the ID printed by `wrangler d1 create` (see
  // DEVELOPER.md's "Comments" section for the full one-time setup).
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "joshhaines-comments",
      "database_id": "cd70e5a8-16d6-4a0b-987e-c30b1565804e",
    },
  ],
  // Sends a moderation-notification email whenever a new comment is
  // submitted for review (see workers/comments-api.ts). Requires
  // joshhaines.com to be onboarded to Cloudflare Email Sending -- see
  // DEVELOPER.md's "Comments" section.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["comments@joshhaines.com"],
    },
  ],
}
